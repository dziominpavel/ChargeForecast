<?xml version="1.0" encoding="utf-8"?>
<!-- updatePeriodMillis — минимальный разрешённый системой интервал (30 мин):
     это НЕ механизм обновления, а страховка от замерзания виджета, если
     процесс убили намертво и сервис не восстановился. Основное обновление —
     push от состояния (design D5), интервал лишь даёт системе повод
     перезапустить процесс и отрисовать честное состояние «слежение
     остановлено» вместо застывшего числа. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/notification_channel_tracking_desc"
    android:initialLayout="@layout/widget_battery"
    android:minHeight="110dp"
    android:minWidth="180dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
