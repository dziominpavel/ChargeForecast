<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Размеры виджета. RemoteViews живёт вне Compose и не видит
         ChargeDimens (ui/theme/Dimens.kt), поэтому значения продублированы —
         радиус совпадает с CardCorner, отступ — с CardPadding. -->
    <dimen name="widget_corner">16dp</dimen>
    <dimen name="widget_padding">12dp</dimen>
    <dimen name="widget_gap">4dp</dimen>
    <dimen name="widget_title_size">13sp</dimen>
    <dimen name="widget_time_size">20sp</dimen>
    <dimen name="widget_level_size">13sp</dimen>

    <!-- Узкий бакет (полоса 1×3): компактные отступы и кегли, строка одна. -->
    <dimen name="widget_padding_narrow">8dp</dimen>
    <dimen name="widget_title_size_narrow">11sp</dimen>
    <dimen name="widget_time_size_narrow">15sp</dimen>
    <dimen name="widget_level_size_narrow">13sp</dimen>

    <!-- Широкий бакет: место больше — кегли крупнее, отступ щедрее. -->
    <dimen name="widget_padding_wide">16dp</dimen>
    <dimen name="widget_gap_wide">6dp</dimen>
    <dimen name="widget_title_size_wide">15sp</dimen>
    <dimen name="widget_time_size_wide">30sp</dimen>
    <dimen name="widget_level_size_wide">15sp</dimen>
</resources>
