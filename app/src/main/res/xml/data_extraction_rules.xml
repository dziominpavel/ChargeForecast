<?xml version="1.0" encoding="utf-8"?>
<!--
    Правила извлечения данных для Android 12+.
    cloud-backup — бэкап в Google One; device-transfer — прямая передача между устройствами.
    Переносится только долговечная часть: сводка, история и кривая (charge_session_cache).
    Машинное состояние (session_runtime) и журнал наблюдений исключены: метки
    elapsedRealtime, ёмкость батареи и незавершённая сессия чужие на новом устройстве.

    Для Android 11 и ниже используется res/xml/backup_rules.xml.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="session_runtime.xml" />
        <exclude domain="file" path="discharge-journal.txt" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="session_runtime.xml" />
        <exclude domain="file" path="discharge-journal.txt" />
    </device-transfer>
</data-extraction-rules>
