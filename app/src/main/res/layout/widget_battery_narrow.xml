<?xml version="1.0" encoding="utf-8"?>
<!-- Узкий бакет (design D7): полоса в одну строку — уровень, время,
     короткая подпись состояния. Всё, что не влезает, обрезается: виджет
     обязан оставаться читаемым на полосе 1×3. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/widget_padding_narrow">

    <TextView
        android:id="@+id/widget_level"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textColor="@color/widget_accent"
        android:textSize="@dimen/widget_level_size_narrow"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/widget_gap"
        android:maxLines="1"
        android:textColor="@color/widget_text_primary"
        android:textSize="@dimen/widget_time_size_narrow"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/widget_gap"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/widget_text_secondary"
        android:textSize="@dimen/widget_title_size_narrow" />
</LinearLayout>
